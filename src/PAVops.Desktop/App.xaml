<Application x:Class="PAVops.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<SolidColorBrush x:Key="CanvasBrush" Color="#F4F6FA"/>
<SolidColorBrush x:Key="InkBrush" Color="#18243A"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
</Application.Resources></Application>
